# Controls what `gcloud builds submit` / `gcloud run deploy --source` uploads as
# the build context. WITHOUT this file gcloud falls back to .gitignore. .dockerignore
# does NOT affect this upload.
#
# Allowlist: upload only what the Dockerfile copies. The repo root collects paper
# sources, TAPS packages, the poster, sibling repos and personal notes, none of which
# belong in a build upload (a denylist here once let ~600 MiB of them through).
/*
!/Dockerfile
!/requirements-web.txt
!/app.py
!/templates/
!/static/
!/verifiquant/

__pycache__/
*.pyc
*.so
.DS_Store
*.db-journal
.env
.env.*

# Inside the package: large datasets the web demo does not read
# (financial_documents.json alone is 95 MiB).
verifiquant/data/*.json
verifiquant/data/*.jsonl
verifiquant/data/*.yaml

# Run artifacts are heavy; ship only the demo run (see VERIFIQUANT_DEMO_RUN in app.py).
# Default demo run: paper_v2_250, the ICAIF '26 paper's 250-contract library + its 250 clean questions.
verifiquant/data/runs/*
!verifiquant/data/runs/paper_v2_250
verifiquant/data/runs/paper_v2_250/*
!verifiquant/data/runs/paper_v2_250/questions_250.jsonl
!verifiquant/data/runs/paper_v2_250/fic
verifiquant/data/runs/paper_v2_250/fic/*
!verifiquant/data/runs/paper_v2_250/fic/cards.db
